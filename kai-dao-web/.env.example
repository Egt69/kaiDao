# Copy to .env.local and adjust. Every value here is PUBLIC.
# This app holds no secret: reads are free, and every write is signed by the
# user's wallet. Never add NEXT_PUBLIC_* for anything sensitive, and never put
# an API key in this file.

# Read-only endpoint. All browser traffic goes through /api/*, never here.
RETIUM_RPC_URL=https://rpc.retium.org

# Public testnet only. Anything other than 3 is refused at startup.
RETIUM_CHAIN_ID=3

# The KaiDAO contract this app is bound to. Code identity is a hash, so pin both.
RETIUM_CONTRACT_ID=cd67349e35f885134d3b3969d9b7780716d9c38abfee155c16cc2a607ba2a931
RETIUM_CONTRACT_CODE_HASH=8b63cfc5fed9fe6f18e38ee46e8d0babb71315aaf8b6957b8dd0cdc9238a6592

# Browser wallet provider. Pin the release and its SRI hash from
# https://wallet.retium.org/connect/sdk/manifest.json
RETIUM_WALLET_SDK_VERSION=1.5.0
RETIUM_WALLET_SDK_INTEGRITY=sha384-IZZw04xxx1GLXviLZ7lw+B5XTi4SNw7Y6fUYf2zdJ8b54pBxVv5KqdvLSjQhZL3v
