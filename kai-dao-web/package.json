{
  "name": "kai-dao-web",
  "version": "0.1.0",
  "private": true,
  "description": "Stake, delegate and govern on KaiDAO, a stake-weighted DAO on the Retium testnet.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:patterns": "node scripts/check-dangerous-patterns.mjs",
    "prebuild": "npm run check:patterns",
    "pretest": "npm run check:patterns",
    "test": "node --test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
